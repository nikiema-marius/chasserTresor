APP_NAME="Chasse au trésor SIAO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SiaoTresor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Chasse au trésor SIAO × Orange Money
# ------------------------------------------------------------------
# Chemin de l'espace admin (changer en production pour le rendre moins devinable)
# Proxies de confiance : * derrière Cloudflare (tunnel ou proxy), vide sinon
TRUSTED_PROXIES=
ADMIN_PATH=admin
# Compte super-admin créé par le seeder (mot de passe généré et affiché si vide)
# Double authentification obligatoire pour les super-admins (true conseillé en production)
ADMIN_2FA_REQUIRED=false
ADMIN_SEED_NAME="Super Admin"
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# OTP SMS : true = code SMS obligatoire ; false = PIN à 4 chiffres
GAME_OTP_ENABLED=false
# Pays acceptés pour les numéros (codes ISO séparés par des virgules)
GAME_PHONE_COUNTRIES=BF,CI,ML,NE,TG,BJ,SN,GH
# Durée de conservation des données personnelles après la fin de la campagne (jours)
GAME_DATA_RETENTION_DAYS=180

# Driver SMS : log (développement) | null | orange | vonage
SMS_DRIVER=log
# [CLÉ API REQUISE] Orange SMS API (developer.orange.com)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS="tel:+22600000000"
ORANGE_SMS_SENDER_NAME=
# [CLÉ API REQUISE] Vonage
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=
